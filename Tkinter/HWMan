def refresh_tree(tree, tasks):
    #clear tree
    for i in tree.get_children():
        tree.delete(i)
    #load tree from list
    for task in tasks:
        tree.insert("", tk.End, values=(task["id"],
                                        task["subject"],
                                        task["desc"],
                                        task["due_date"],
                                        task["status"]))

